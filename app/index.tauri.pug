doctype html
html.tabby
    head
        meta(charset='UTF-8')
        meta(name='viewport', content='width=device-width, initial-scale=1')
        base(href='./')
        script.
            console.timeStamp('index')
        script(src='./bundle.js', defer)
        style.
            body { transition: 0.5s background; }
    body
        style#custom-css
        root
        app-root
            .preload-logo
                div
                    .tabby-logo
                    h1.tabby-title Tabby RS
                    .progress
                        .bar(style='width: 0%')
